// renderers/bountyCardEnd.cjs
const fs = require("fs");
const path = require("path");
const { createCanvas, loadImage } = require("canvas");

const CARD_WIDTH = 2200;
const CARD_HEIGHT = 1300;
const MARGIN = 40;

const CARDS_DIR = path.join(__dirname, "card-images");
const SPRITES_DIR = path.join(__dirname, "..", "sprites");

if (!fs.existsSync(CARDS_DIR)) {
  fs.mkdirSync(CARDS_DIR, { recursive: true });
}

// Styles for completed/failed
const statusStyles = {
  completed: {
    gradientFrom: "#22c55e", // green
    gradientTo: "#16a34a",
    boxColor: "rgba(5, 46, 22, 0.95)"
  },
  failed: {
    gradientFrom: "#ef4444", // red
    gradientTo: "#b91c1c",
    boxColor: "rgba(127, 29, 29, 0.95)"
  }
};

function roundedRect(ctx, x, y, w, h, r) {
  const radius = Math.min(r, w / 2, h / 2);
  ctx.beginPath();
  ctx.moveTo(x + radius, y);
  ctx.lineTo(x + w - radius, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + radius);
  ctx.lineTo(x + w, y + h - radius);
  ctx.quadraticCurveTo(x + w, y + h, x + w - radius, y + h);
  ctx.lineTo(x + radius, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - radius);
  ctx.lineTo(x, y + radius);
  ctx.quadraticCurveTo(x, y, x + radius, y);
  ctx.closePath();
}

function getSpritePath(name) {
  if (!name) return null;
  return path.join(SPRITES_DIR, `${name}.png`);
}

async function drawSprite(ctx, x, y, size, name) {
  ctx.save();
  roundedRect(ctx, x, y, size, size, 30);
  ctx.fillStyle = "rgba(15, 23, 42, 0.98)";
  ctx.fill();
  ctx.lineWidth = 6;
  ctx.strokeStyle = "#f9fafb";
  ctx.stroke();

  const spritePath = getSpritePath(name);
  let img = null;
  try {
    if (fs.existsSync(spritePath)) img = await loadImage(spritePath);
  } catch {}

  if (img) {
    const pad = size * 0.12;
    const maxW = size - pad * 2;
    const maxH = size - pad * 2;
    const aspect = img.width / img.height;

    let drawW = maxW;
    let drawH = maxH;
    if (aspect > 1) drawH = maxW / aspect;
    else drawW = maxH * aspect;

    ctx.drawImage(
      img,
      x + (size - drawW) / 2,
      y + (size - drawH) / 2,
      drawW,
      drawH
    );
  }

  ctx.restore();
}

async function createBountyCardEnd(options) {
  const {
    bountyId,
    username,
    rankName,
    pokemons,
    rewardLabel,
    avatarUrl,
    mode // "completed" or "failed"
  } = options;

  const style = statusStyles[mode] || statusStyles.failed;
  const pokemonList = pokemons?.length ? pokemons : ["None"];

  const canvas = createCanvas(CARD_WIDTH, CARD_HEIGHT);
  const ctx = canvas.getContext("2d");

  // Background
  const g = ctx.createLinearGradient(0, 0, CARD_WIDTH, CARD_HEIGHT);
  g.addColorStop(0, style.gradientFrom);
  g.addColorStop(1, style.gradientTo);
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);

  ctx.fillStyle = "rgba(0,0,0,0.2)";
  ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);

  // Right image box
  const rightW = (CARD_WIDTH - MARGIN * 3) * 0.4;
  const rightH = CARD_HEIGHT - MARGIN * 2;
  const imageSize = Math.min(rightW, rightH);
  const imageX = CARD_WIDTH - MARGIN - imageSize;
  const imageY = MARGIN;

  ctx.save();
  try {
    const img = await loadImage(avatarUrl);
    roundedRect(ctx, imageX, imageY, imageSize, imageSize, 40);
    ctx.clip();

    let w = imageSize;
    let h = imageSize;
    const aspect = img.width / img.height;

    if (aspect > 1) h = imageSize / aspect;
    else w = imageSize * aspect;

    ctx.drawImage(
      img,
      imageX + (imageSize - w) / 2,
      imageY + (imageSize - h) / 2,
      w,
      h
    );
  } catch {
    ctx.fillStyle = "rgba(15,23,42,0.9)";
    roundedRect(ctx, imageX, imageY, imageSize, imageSize, 40);
    ctx.fill();
  }
  ctx.restore();

  // Left info box
  const leftX = MARGIN;
  const leftY = MARGIN;
  const leftWidth = imageX - MARGIN - leftX;
  const leftHeight = CARD_HEIGHT - MARGIN * 2;

  // Info + Note split
  const boxGap = 40;
  const infoBoxHeight = leftHeight * 0.65;
  const noteBoxHeight = leftHeight - infoBoxHeight - boxGap;

  // Info box
  roundedRect(ctx, leftX, leftY, leftWidth, infoBoxHeight, 40);
  ctx.fillStyle = style.boxColor;
  ctx.fill();
  ctx.lineWidth = 8;
  ctx.strokeStyle = "#f9fafb";
  ctx.stroke();

  const FONT = 55;
  const lh = FONT * 1.25;

  ctx.font = `bold ${FONT}px sans-serif`;
  ctx.fillStyle = "#f9fafb";

  let lineY = leftY + 80;

  ctx.fillText(`Trainer:`, leftX + 60, lineY);
  ctx.fillText(username, leftX + 400, lineY);
  lineY += lh;

  ctx.fillText(`Rank:`, leftX + 60, lineY);
  ctx.fillText(rankName, leftX + 400, lineY);
  lineY += lh * 1.2;

  ctx.fillText(`Target:`, leftX + 60, lineY);
  ctx.fillText(pokemonList[0], leftX + 400, lineY);
  lineY += lh;

  for (let i = 1; i < pokemonList.length; i++) {
    ctx.fillText(pokemonList[i], leftX + 400, lineY);
    lineY += lh;
  }

  lineY += lh * 0.6;

  ctx.fillText(`Reward:`, leftX + 60, lineY);
  ctx.fillText(rewardLabel, leftX + 400, lineY);
  lineY += lh * 1.4;

  if (mode === "completed") {
    ctx.fillText(
      `${username} has successfully completed the bounty`,
      leftX + 60,
      lineY
    );
  }

  // Note box
  const noteY = leftY + infoBoxHeight + boxGap;
  roundedRect(ctx, leftX, noteY, leftWidth, noteBoxHeight, 40);
  ctx.fillStyle = style.boxColor;
  ctx.fill();
  ctx.lineWidth = 8;
  ctx.strokeStyle = "#f9fafb";
  ctx.stroke();

  ctx.font = `bold ${FONT}px sans-serif`;
  ctx.fillStyle = "#f9fafb";

  const text =
    mode === "completed" ? "Completed" : mode === "failed" ? "Bounty Failed" : "";

  ctx.fillText(text, leftX + 60, noteY + noteBoxHeight / 2 - FONT / 2);

  // Sprites (same layout as original)
  const spriteSize = imageSize / 3 - 20;
  const spriteY = CARD_HEIGHT - MARGIN - spriteSize - 20;
  let spriteX = imageX;

  for (const p of pokemonList.slice(0, 3)) {
    await drawSprite(ctx, spriteX, spriteY, spriteSize, p);
    spriteX += spriteSize + 30;
  }

  const buffer = canvas.toBuffer("image/png");
  const filePath = path.join(CARDS_DIR, `bountyEnd_${bountyId}.png`);
  fs.writeFileSync(filePath, buffer);

  return buffer;
}

module.exports = { createBountyCardEnd };