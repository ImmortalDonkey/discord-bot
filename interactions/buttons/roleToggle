const rolesConfig = require('../../utils/rolesConfig.cjs');

module.exports = {
  ids: [
    'role:rarity_',
    'role:pokemon_',
    'role:clear_all',
    'role:view_status'
  ],

  async execute(client, interaction) {
    await interaction.deferUpdate();

    const member = interaction.member;
    if (!member) return;

    const id = interaction.customId;

    // VIEW MY NOTIFICATIONS
    if (id === 'role:view_status') {
      const names = member.roles.cache
        .filter(r => r.name !== '@everyone')
        .map(r => r.name);

      return interaction.followUp({
        content: names.length
          ? `🔔 **Your notifications:**\n${names.map(n => `• ${n}`).join('\n')}`
          : '🔕 You have no notification roles selected.',
        ephemeral: true
      });
    }

    // CLEAR ALL
    if (id === 'role:clear_all') {
      const ids = [
        ...rolesConfig.rarityRoles.map(r => process.env[r.env]),
        ...rolesConfig.pokemonRoles.map(p => process.env[p.env])
      ].filter(Boolean);

      for (const rid of ids) {
        if (member.roles.cache.has(rid)) {
          await member.roles.remove(rid).catch(() => {});
        }
      }
      return;
    }

    // RARITY TOGGLE
    if (id.startsWith('role:rarity:')) {
      const [, , group, action] = id.split(':');

      const rarity = rolesConfig.rarityRoles.find(r =>
        r.env.toLowerCase().includes(group)
      );
      if (!rarity) return;

      const roleId = process.env[rarity.env];
      if (!roleId) return;

      return action === 'on'
        ? member.roles.add(roleId).catch(() => {})
        : member.roles.remove(roleId).catch(() => {});
    }

    // POKEMON TOGGLE
    if (id.startsWith('role:pokemon:')) {
      const [, , key, action] = id.split(':');

      const pokemon = rolesConfig.pokemonRoles.find(p =>
        p.env.toLowerCase().endsWith(key)
      );
      if (!pokemon) return;

      const roleId = process.env[pokemon.env];
      if (!roleId) return;

      return action === 'on'
        ? member.roles.add(roleId).catch(() => {})
        : member.roles.remove(roleId).catch(() => {});
    }
  }
};